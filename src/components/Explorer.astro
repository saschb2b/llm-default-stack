---
import {
	getModels,
	resolveStack,
	tallyDimension,
	DIMENSIONS,
	STATUS_LABEL,
	KIND_LABEL,
	NONCOMMITTAL,
	type Version,
} from '../lib/models';

const models = await getModels();
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const detailHref = (id: string) => `${base}/models/${id}/`;

const tallies = DIMENSIONS.map((d) => {
	const t = tallyDimension(models, d.key);
	return { ...d, top: t.choices[0], documented: t.documented };
});

// A synthetic single "version" for families (products) that don't list any.
function versionsOf(m: (typeof models)[number]): Version[] {
	if (m.data.versions.length) return m.data.versions;
	return [{ name: m.data.family, status: 'current', sources: [] } as Version];
}

function haystack(m: (typeof models)[number]): string {
	return [
		m.data.vendor,
		m.data.family,
		m.data.kind,
		...versionsOf(m).map((v) => v.name),
	]
		.join(' ')
		.toLowerCase();
}

function choiceList(m: (typeof models)[number]): string {
	const names = new Set<string>();
	for (const { key } of DIMENSIONS)
		for (const c of m.data.defaultStack[key] ?? []) names.add(c.name);
	return [...names].join('|');
}
---

<div class="explorer" data-explorer>
	<!-- Convergence headline -->
	<ul class="convergence" aria-label="Where the columns converge">
		{
			tallies.map((t) => (
				<li>
					<span class="dim-label">{t.label}</span>
					<span class="lead">{t.top?.name ?? '—'}</span>
					<span class="bar" aria-hidden="true">
						<span
							class="bar-fill"
							style={`width:${Math.round((t.top?.share ?? 0) * 100)}%`}
						/>
					</span>
					<span class="frac">
						{t.top?.count ?? 0} of {t.documented} with a default
					</span>
				</li>
			))
		}
	</ul>

	<!-- Controls -->
	<div class="controls">
		<input
			type="search"
			class="search"
			placeholder="Search models, vendors, versions…"
			aria-label="Search models"
			data-search
		/>
		<div class="seg" role="group" aria-label="Filter by kind" data-kind>
			<button type="button" data-kind-btn="all" class="active">All</button>
			<button type="button" data-kind-btn="model">Models</button>
			<button type="button" data-kind-btn="product">Builders</button>
			<button type="button" data-kind-btn="agent">Agents</button>
		</div>
		<div class="seg" role="group" aria-label="View" data-view>
			<button type="button" data-view-btn="cards" class="active">Cards</button>
			<button type="button" data-view-btn="matrix">Matrix</button>
		</div>
	</div>

	<div class="active-filter" data-active-filter hidden>
		Filtering by <strong data-filter-label></strong>
		<button type="button" class="clear" data-clear-filter>clear ✕</button>
	</div>

	<!-- Cards view -->
	<div class="cards" data-cards>
		{
			models.map((m) => {
				const current = versionsOf(m)[0];
				const stack = resolveStack(m);
				const versionCount = m.data.versions.length;
				return (
					<article
						class="card"
						data-card
						data-kind={m.data.kind}
						data-haystack={haystack(m)}
						data-choices={choiceList(m)}
						data-id={m.id}
					>
						<header class="card-head">
							<div class="title">
								<span class="vendor">{m.data.vendor}</span>
								<h3>
									<a href={detailHref(m.id)}>{m.data.family}</a>
								</h3>
							</div>
							<span class={`kind kind-${m.data.kind}`}>
								{KIND_LABEL[m.data.kind]}
							</span>
						</header>

						{m.data.blurb && <p class="blurb">{m.data.blurb}</p>}
						{m.data.poweredBy && (
							<p class="powered">
								Powered by <span>{m.data.poweredBy}</span>
							</p>
						)}

						{current.releaseDate || m.data.kind === 'model' ? (
							<p class="card-version">
								<span class={`status status-${current.status}`}>
									{STATUS_LABEL[current.status]}
								</span>
								<span class="vname">{current.name}</span>
								{current.releaseDate && (
									<span class="date">{current.releaseDate}</span>
								)}
							</p>
						) : null}

						<dl class="dims">
							{DIMENSIONS.map((d) => (
								<div class="dim">
									<dt>{d.label}</dt>
									<dd data-dim={d.key}>
										{stack[d.key].length ? (
											stack[d.key].map((c) => (
												<button
													type="button"
													class={`chip${NONCOMMITTAL.has(c.name) ? ' chip-soft' : ''}`}
													data-choice={c.name}
													title={
														c.note
															? `${c.name} — ${c.note}`
															: `Filter by ${c.name}`
													}
												>
													{c.name}
												</button>
											))
										) : (
											<span class="chip-empty">Not documented</span>
										)}
									</dd>
								</div>
							))}
						</dl>

						<footer class="card-foot">
							<a class="details-link" href={detailHref(m.id)}>
								{versionCount > 1
									? `Details · ${versionCount} versions`
									: 'Details & sources'}
								<span aria-hidden="true"> →</span>
							</a>
						</footer>
					</article>
				);
			})
		}
	</div>

	<!-- Matrix view -->
	<div class="matrix-wrap" data-matrix hidden>
		<table class="matrix">
			<thead>
				<tr>
					<th scope="col">Model</th>
					{DIMENSIONS.map((d) => <th scope="col">{d.label}</th>)}
				</tr>
			</thead>
			<tbody>
				{
					models.map((m) => {
						const stack = resolveStack(m);
						return (
							<tr
								data-row
								data-kind={m.data.kind}
								data-haystack={haystack(m)}
								data-choices={choiceList(m)}
							>
								<th scope="row">
									<span class="vendor">{m.data.vendor}</span>
									<a href={detailHref(m.id)}>{m.data.family}</a>
								</th>
								{DIMENSIONS.map((d) => (
									<td>
										{stack[d.key].length ? (
											stack[d.key].map((c) => (
												<button
													type="button"
													class={`chip${NONCOMMITTAL.has(c.name) ? ' chip-soft' : ''}`}
													data-choice={c.name}
												>
													{c.name}
												</button>
											))
										) : (
											<span class="chip-empty">—</span>
										)}
									</td>
								))}
							</tr>
						);
					})
				}
			</tbody>
		</table>
	</div>

	<p class="empty" data-empty hidden>No models match those filters.</p>
</div>

<script>
	function init(root: HTMLElement) {
		const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
		const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
		const searchEl = root.querySelector<HTMLInputElement>('[data-search]');
		const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
		const cardsView = root.querySelector<HTMLElement>('[data-cards]');
		const matrixView = root.querySelector<HTMLElement>('[data-matrix]');
		const activeFilterBar = root.querySelector<HTMLElement>(
			'[data-active-filter]',
		);
		const filterLabel = root.querySelector<HTMLElement>('[data-filter-label]');

		const state = { q: '', kind: 'all', choice: '', view: 'cards' };

		function apply() {
			const items = state.view === 'matrix' ? rows : cards;
			let visible = 0;
			const all = [...cards, ...rows];
			for (const el of all) {
				const kindOk = state.kind === 'all' || el.dataset.kind === state.kind;
				const qOk =
					!state.q || (el.dataset.haystack || '').includes(state.q);
				const choiceOk =
					!state.choice ||
					(el.dataset.choices || '').split('|').includes(state.choice);
				const show = kindOk && qOk && choiceOk;
				el.toggleAttribute('hidden', !show);
			}
			for (const el of items) if (!el.hasAttribute('hidden')) visible++;
			emptyEl?.toggleAttribute('hidden', visible !== 0);
			// reflect active choice highlighting
			root
				.querySelectorAll<HTMLElement>('.chip[data-choice]')
				.forEach((chip) =>
					chip.classList.toggle(
						'chip-active',
						!!state.choice && chip.dataset.choice === state.choice,
					),
				);
		}

		function setChoice(choice: string) {
			state.choice = state.choice === choice ? '' : choice;
			if (state.choice && filterLabel) filterLabel.textContent = state.choice;
			activeFilterBar?.toggleAttribute('hidden', !state.choice);
			apply();
		}

		// Search
		searchEl?.addEventListener('input', () => {
			state.q = (searchEl.value || '').trim().toLowerCase();
			apply();
		});

		// Kind + view segmented controls
		root.querySelectorAll<HTMLElement>('[data-kind-btn]').forEach((btn) =>
			btn.addEventListener('click', () => {
				state.kind = btn.dataset.kindBtn!;
				root
					.querySelectorAll('[data-kind-btn]')
					.forEach((b) => b.classList.toggle('active', b === btn));
				apply();
			}),
		);
		root.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((btn) =>
			btn.addEventListener('click', () => {
				state.view = btn.dataset.viewBtn!;
				root
					.querySelectorAll('[data-view-btn]')
					.forEach((b) => b.classList.toggle('active', b === btn));
				cardsView?.toggleAttribute('hidden', state.view !== 'cards');
				matrixView?.toggleAttribute('hidden', state.view !== 'matrix');
				apply();
			}),
		);

		// Clear filter
		root
			.querySelector('[data-clear-filter]')
			?.addEventListener('click', () => setChoice(state.choice));

		// Chip clicks (delegated)
		root.addEventListener('click', (e) => {
			const chip = (e.target as HTMLElement).closest<HTMLElement>(
				'.chip[data-choice]',
			);
			if (chip && root.contains(chip)) setChoice(chip.dataset.choice!);
		});

		apply();
	}

	document
		.querySelectorAll<HTMLElement>('[data-explorer]')
		.forEach((el) => init(el));
</script>

<style>
	.explorer {
		--chip-bg: var(--sl-color-gray-6);
		--chip-bg-hover: var(--sl-color-gray-5);
		margin-top: 1.5rem;
	}

	/* The [hidden] attribute is how filtering / view-switching toggles items.
	   Several elements below set an explicit `display`, which would otherwise
	   beat the UA `[hidden] { display: none }` rule — force it to win. */
	.explorer [hidden] {
		display: none !important;
	}

	/* Convergence headline */
	.convergence {
		list-style: none;
		padding: 0;
		margin: 0 0 1.75rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 0.75rem;
	}
	.convergence li {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		padding: 0.7rem 0.8rem;
		background: var(--sl-color-black);
	}
	.convergence .dim-label {
		display: block;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-gray-3);
	}
	.convergence .lead {
		display: block;
		font-weight: 600;
		font-size: 1.05rem;
		margin: 0.15rem 0 0.4rem;
		color: var(--sl-color-white);
	}
	.convergence .bar {
		display: block;
		height: 5px;
		border-radius: 3px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}
	.convergence .bar-fill {
		display: block;
		height: 100%;
		background: var(--sl-color-accent);
	}
	.convergence .frac {
		display: block;
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		margin-top: 0.35rem;
	}

	/* Controls */
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
		margin-bottom: 0.9rem;
	}
	.search {
		flex: 1 1 14rem;
		min-width: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
	}
	.search:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.seg {
		display: inline-flex;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	.seg button {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.45rem 0.8rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		border: 0;
		cursor: pointer;
	}
	.seg button + button {
		border-left: 1px solid var(--sl-color-gray-5);
	}
	.seg button:hover {
		background: var(--chip-bg-hover);
	}
	.seg button.active {
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	.active-filter {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		margin-bottom: 1rem;
		color: var(--sl-color-gray-2);
	}
	.active-filter .clear {
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		padding: 0.15rem 0.5rem;
	}

	/* Cards */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
		gap: 1rem;
	}
	.card {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		padding: 1rem 1.1rem 0.9rem;
		background: var(--sl-color-black);
		display: flex;
		flex-direction: column;
	}
	.card-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.5rem;
	}
	.card-head .vendor {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-gray-3);
	}
	.card-head h3 {
		margin: 0.1rem 0 0;
		font-size: 1.15rem;
	}
	.card-head h3 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.card-head h3 a:hover {
		color: var(--sl-color-accent-high);
		text-decoration: underline;
	}
	.kind {
		font-size: 0.68rem;
		padding: 0.15rem 0.5rem;
		border-radius: 1rem;
		white-space: nowrap;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	.kind-product {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.kind-agent {
		border-color: var(--sl-color-purple, #8b5cf6);
		color: var(--sl-color-purple-high, #a78bfa);
	}
	.blurb {
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		margin: 0.6rem 0 0.4rem;
		line-height: 1.45;
	}
	.powered {
		font-size: 0.74rem;
		color: var(--sl-color-gray-3);
		margin: 0 0 0.2rem;
	}
	.powered span {
		color: var(--sl-color-gray-1);
		font-weight: 600;
	}

	.card-version {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0.5rem 0 0;
		font-size: 0.78rem;
		color: var(--sl-color-gray-3);
	}
	.card-version .vname {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.explorer :global(.status) {
		padding: 0.1rem 0.45rem;
		border-radius: 1rem;
		font-size: 0.68rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.explorer :global(.status-current) {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.explorer :global(.status-preview) {
		border-color: var(--sl-color-orange, #c2740c);
		color: var(--sl-color-orange-high, #e8920c);
	}
	.dims {
		margin: 0.85rem 0 0;
		display: grid;
		gap: 0.55rem;
	}
	.dim {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.5rem;
		align-items: baseline;
	}
	.dim dt {
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	.dim dd {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	/* Chip and status-badge styles, namespaced under the (scoped) .explorer
	   root via :global() so they're robust regardless of how the element is
	   produced. */
	.explorer :global(.chip) {
		font: inherit;
		font-size: 0.78rem;
		line-height: 1.2;
		padding: 0.2rem 0.55rem;
		border-radius: 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--chip-bg);
		color: var(--sl-color-white);
		cursor: pointer;
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
	}
	.explorer :global(.chip:hover) {
		background: var(--chip-bg-hover);
		border-color: var(--sl-color-accent);
	}
	.explorer :global(.chip-active) {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.explorer :global(.chip-soft) {
		background: transparent;
		color: var(--sl-color-gray-2);
		border-style: dashed;
	}
	.explorer :global(.chip-empty) {
		font-size: 0.78rem;
		color: var(--sl-color-gray-4);
		font-style: italic;
	}

	.card-foot {
		margin-top: auto;
		padding-top: 0.75rem;
	}
	.details-link {
		display: inline-block;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-accent-high);
	}
	.details-link:hover {
		text-decoration: underline;
	}

	/* Matrix */
	.matrix-wrap {
		overflow-x: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
	}
	.matrix {
		border-collapse: collapse;
		width: 100%;
		font-size: 0.82rem;
		margin: 0;
	}
	.matrix th,
	.matrix td {
		text-align: left;
		padding: 0.6rem 0.7rem;
		border-bottom: 1px solid var(--sl-color-gray-6);
		vertical-align: top;
	}
	.matrix thead th {
		position: sticky;
		top: 0;
		background: var(--sl-color-gray-6);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.matrix tbody th .vendor {
		display: block;
		font-size: 0.68rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.matrix td {
		display: table-cell;
	}
	.matrix td .chip {
		margin: 0.1rem 0.2rem 0.1rem 0;
	}

	.empty {
		text-align: center;
		color: var(--sl-color-gray-3);
		padding: 2rem 0;
	}

	@media (max-width: 480px) {
		.dim {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
