---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	getModels,
	resolveStack,
	DIMENSIONS,
	KIND_LABEL,
	STATUS_LABEL,
	NONCOMMITTAL,
} from '../../lib/models';
import { lagFor } from '../../lib/stack-versions';
import { PRACTICES, PRACTICE_BY_ID } from '../../lib/practices';

const STATUS_MARK: Record<string, string> = {
	adopted: '✓',
	partial: '~',
	missing: '✗',
	unknown: '–',
};
const STATUS_TEXT: Record<string, string> = {
	adopted: 'Adopted',
	partial: 'Partial',
	missing: 'Missing',
	unknown: 'Unknown',
};

function lagLabel(lag: ReturnType<typeof lagFor>): string {
	if (!lag || lag.majorsBehind == null) return '—';
	if (lag.majorsBehind === 0) return 'current';
	return `${lag.majorsBehind} major${lag.majorsBehind > 1 ? 's' : ''} behind`;
}

export async function getStaticPaths() {
	const models = await getModels();
	return models.map((m) => ({ params: { id: m.id }, props: { model: m } }));
}

const { model } = Astro.props;
const d = model.data;
const stack = resolveStack(model);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const versions = d.versions;
const sources = d.sources;
const emits = d.emits;

// Group the model's checklist statuses by practice group, preserving the
// canonical order in PRACTICES.
const statusById = new Map(d.checklist.map((c) => [c.id, c]));
const checklistGroups: {
	group: string;
	items: { practice: (typeof PRACTICES)[number]; status: string; note?: string }[];
}[] = [];
for (const practice of PRACTICES) {
	const c = statusById.get(practice.id);
	if (!c) continue;
	let g = checklistGroups.find((x) => x.group === practice.group);
	if (!g) {
		g = { group: practice.group, items: [] };
		checklistGroups.push(g);
	}
	g.items.push({ practice, status: c.status, note: c.note });
}
const hasChecklist = checklistGroups.length > 0;

// Build the on-page table of contents for the sections we actually render.
const headings = [{ depth: 2, slug: 'default-stack', text: 'Default stack' }];
if (emits.length) headings.push({ depth: 2, slug: 'version-lag', text: 'Version lag' });
if (hasChecklist)
	headings.push({ depth: 2, slug: 'checklist', text: 'Modern-practice checklist' });
if (versions.length) headings.push({ depth: 2, slug: 'versions', text: 'Versions' });
if (sources.length) headings.push({ depth: 2, slug: 'sources', text: 'Sources' });
---

<StarlightPage
	frontmatter={{
		title: d.family,
		description:
			d.blurb ?? `The default React stack ${d.family} reaches for.`,
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
	}}
	headings={headings}
>
	<p class="meta">
		<span class="vendor">{d.vendor}</span>
		<span class={`kind kind-${d.kind}`}>{KIND_LABEL[d.kind]}</span>
		{d.poweredBy && (
			<span class="powered">
				Powered by <strong>{d.poweredBy}</strong>
			</span>
		)}
		{d.url && (
			<a class="visit" href={d.url} target="_blank" rel="noopener">
				Visit {d.family} ↗
			</a>
		)}
	</p>

	{d.blurb && <p class="lead">{d.blurb}</p>}

	<h2 id="default-stack">Default stack</h2>
	<dl class="stack">
		{
			DIMENSIONS.map((dim) => (
				<div class="row">
					<dt>
						{dim.label}
						<small>{dim.blurb}</small>
					</dt>
					<dd>
						{stack[dim.key].length ? (
							stack[dim.key].map((c) => (
								<span class={`chip${NONCOMMITTAL.has(c.name) ? ' soft' : ''}`}>
									{c.name}
									{c.note && <em>{c.note}</em>}
								</span>
							))
						) : (
							<span class="empty">Not documented</span>
						)}
					</dd>
				</div>
			))
		}
	</dl>

	{
		emits.length > 0 && (
			<>
				<h2 id="version-lag">Version lag</h2>
				<p class="note">
					The library versions {d.family} emits by default, against the latest
					stable major — the{' '}
					<a href={`${base}/about/convergence/`}>permanent version lag</a>.
					Observational; tested on the current flagship.
				</p>
				<table class="emits">
					<thead>
						<tr>
							<th>Library</th>
							<th>Emits</th>
							<th>Latest</th>
							<th>Lag</th>
						</tr>
					</thead>
					<tbody>
						{emits.map((e) => {
							const lag = lagFor(e.name, e.version);
							const behind = lag?.majorsBehind ?? null;
							return (
								<tr>
									<th scope="row">{e.name}</th>
									<td>
										{e.version}
										{e.note && <small>{e.note}</small>}
									</td>
									<td>{lag ? lag.latest : '—'}</td>
									<td>
										<span
											class={`lag${behind ? ' lag-behind' : behind === 0 ? ' lag-current' : ''}`}
										>
											{lagLabel(lag)}
										</span>
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</>
		)
	}

	{
		hasChecklist && (
			<>
				<h2 id="checklist">Modern-practice checklist</h2>
				<p class="note">
					How {d.family} measures up on current React / tooling idioms by
					default. Observational — verify by testing.
				</p>
				{checklistGroups.map((g) => (
					<div class="check-group">
						<p class="check-group-title">{g.group}</p>
						<ul class="checklist">
							{g.items.map((it) => (
								<li class={`check check-${it.status}`}>
									<span class="mark" aria-hidden="true">
										{STATUS_MARK[it.status]}
									</span>
									<div class="check-body">
										<span class="check-head">
											<strong>{it.practice.label}</strong>
											<span class="status-label">{STATUS_TEXT[it.status]}</span>
											<a
												class="ref"
												href={it.practice.source}
												target="_blank"
												rel="noopener"
											>
												docs ↗
											</a>
										</span>
										<span class="check-blurb">
											{it.practice.blurb}
											{it.note && <em> — {it.note}</em>}
										</span>
									</div>
								</li>
							))}
						</ul>
					</div>
				))}
			</>
		)
	}

	{
		versions.length > 0 && (
			<>
				<h2 id="versions">Versions</h2>
				<p class="note">
					Defaults are observed at the family/generation level — see the{' '}
					<a href={`${base}/about/methodology/`}>methodology</a>. A version only
					diverges where a specific difference has been measured.
				</p>
				<table class="versions">
					<thead>
						<tr>
							<th>Version</th>
							<th>Status</th>
							<th>Released</th>
							<th>Notes</th>
						</tr>
					</thead>
					<tbody>
						{versions.map((v) => (
							<tr>
								<th scope="row">{v.name}</th>
								<td>
									<span class={`status status-${v.status}`}>
										{STATUS_LABEL[v.status]}
									</span>
								</td>
								<td>{v.releaseDate ?? '—'}</td>
								<td>{v.notes ?? ''}</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}

	{
		sources.length > 0 && (
			<>
				<h2 id="sources">Sources</h2>
				<ul class="sources">
					{sources.map((s) => (
						<li>
							{s.url ? (
								<a href={s.url} target="_blank" rel="noopener">
									{s.label}
								</a>
							) : (
								s.label
							)}
						</li>
					))}
				</ul>
			</>
		)
	}

	<p class="back">
		<a href={`${base}/explorer/`}>← Back to the explorer</a>
	</p>
</StarlightPage>

<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
	.meta .vendor {
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
	}
	.kind {
		font-size: 0.68rem;
		padding: 0.15rem 0.5rem;
		border-radius: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	.kind-product {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.kind-agent {
		border-color: var(--sl-color-purple, #8b5cf6);
		color: var(--sl-color-purple-high, #a78bfa);
	}
	.meta .visit {
		margin-left: auto;
	}
	.lead {
		font-size: 1.05rem;
		color: var(--sl-color-gray-1);
	}

	.stack {
		display: grid;
		gap: 0.25rem;
		margin: 0;
	}
	.stack .row {
		display: grid;
		grid-template-columns: 12rem 1fr;
		gap: 1rem;
		align-items: baseline;
		padding: 0.7rem 0;
		border-top: 1px solid var(--sl-color-gray-6);
	}
	.stack dt {
		font-weight: 600;
	}
	.stack dt small {
		display: block;
		font-weight: 400;
		font-size: 0.74rem;
		color: var(--sl-color-gray-3);
	}
	.stack dd {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.chip {
		font-size: 0.85rem;
		line-height: 1.2;
		padding: 0.2rem 0.6rem;
		border-radius: 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
	}
	.chip.soft {
		background: transparent;
		color: var(--sl-color-gray-2);
		border-style: dashed;
	}
	.chip em {
		font-style: normal;
		font-size: 0.72rem;
		opacity: 0.7;
	}
	.empty {
		color: var(--sl-color-gray-4);
		font-style: italic;
	}

	.note {
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}
	.versions,
	.emits {
		width: 100%;
	}
	.emits td small {
		display: block;
		font-size: 0.74rem;
		color: var(--sl-color-gray-3);
	}
	.lag {
		white-space: nowrap;
	}
	.lag-current {
		color: var(--sl-color-green-high, #3ba55d);
	}
	.lag-behind {
		color: var(--sl-color-orange-high, #e8920c);
		font-weight: 600;
	}

	.check-group {
		margin-top: 1.5rem;
	}
	.check-group-title {
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-gray-3);
		margin: 0 0 0.5rem;
	}
	.checklist {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}
	.check {
		margin: 0;
		display: grid;
		grid-template-columns: 1.6rem 1fr;
		gap: 0.6rem;
		align-items: start;
	}
	.mark {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
		font-weight: 700;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-3);
	}
	.check-adopted .mark {
		color: var(--sl-color-green-high, #3ba55d);
		border-color: var(--sl-color-green, #3ba55d);
	}
	.check-partial .mark {
		color: var(--sl-color-orange-high, #e8920c);
		border-color: var(--sl-color-orange, #c2740c);
	}
	.check-missing .mark {
		color: var(--sl-color-red-high, #e5484d);
		border-color: var(--sl-color-red, #c2474b);
	}
	.check-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}
	.status-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
	}
	.ref {
		font-size: 0.72rem;
		margin-left: auto;
	}
	.check-blurb {
		display: block;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		margin-top: 0.15rem;
	}
	.check-blurb em {
		color: var(--sl-color-gray-3);
	}
	.status {
		padding: 0.1rem 0.45rem;
		border-radius: 1rem;
		font-size: 0.72rem;
		border: 1px solid var(--sl-color-gray-5);
		white-space: nowrap;
	}
	.status-current {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.status-preview {
		border-color: var(--sl-color-orange, #c2740c);
		color: var(--sl-color-orange-high, #e8920c);
	}

	.back {
		margin-top: 2.5rem;
		font-size: 0.9rem;
	}

	@media (max-width: 50rem) {
		.stack .row {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
	}
</style>
